# Resend email — used by the /api/send-email serverless function.
# Set the real values in the Vercel dashboard (Project → Settings →
# Environment Variables). For local `vercel dev`, copy this file to
# `.env.local` (gitignored) and fill in real values.

# Your Resend API key (https://resend.com/api-keys).
RESEND_API_KEY=your_resend_key_here

# Verified sender. The domain must be verified in Resend.
RESEND_FROM="DNDN 2026 Secretariat <no-reply@dioceseofnigerdeltanorth.org>"
